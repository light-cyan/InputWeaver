TARGET = "notepad.exe";
TAP_DURATION = 25ms;
ACTION_GAP = 40ms;

state enabled = on;
number burstCount = 3;
duration repeatDelay = 120ms;

// Duration arithmetic and state mutation.
F1:down => set(repeatDelay, repeatDelay + 20ms) tap(Digit1);

// Native process launch. Run this optional case last.
F2:down => exec("notepad.exe");

// Continue matching, conditions, and two ordered action tasks.
F3:down when enabled[on] ~>> tap(X);
F3:down when PAUSE[on] => tap(Y);

// Windows-native raw control identity.
F4:down => tap(Windows.VirtualKey(0x5A));

// Nested if and repeat control structures.
F5:down =>
    if enabled[on] then
        repeat 2 do
            tap(Digit2) |
        end
    else
        tap(Digit0)
    end;

// Full down, repeat, and up lifecycle mapping.
F6 := A when enabled[on];

// User state mutation.
F7:down => toggle(enabled);

// Press, tap, release, and authored action gap.
F8:down when enabled[on] =>
    press(LShift)
    tap(I) tap(N) tap(P) tap(U) tap(T) |
    tap(W) tap(E) tap(A) tap(V) tap(E) tap(R)
    release(LShift);

// Variable repeat count.
F9:down when enabled[on] =>
    repeat burstCount do
        tap(B) |
    end;

// Number arithmetic and a conditional branch that observes the new value.
F10:down =>
    set(burstCount, burstCount + 1)
    if burstCount >= 4 then
        tap(Digit4)
    else
        tap(Digit3)
    end;

// A held-state loop with a configurable duration.
F11:down when enabled[on] =>
    while F11[held] do
        tap(C)
        wait(repeatDelay)
    end;
F11:repeat =>;
F11:up =>;

// Synchronous PAUSE control.
pause F12:down => toggle;

// Mouse source routing and keyboard output.
Mouse.Middle:down when enabled[on] => tap(Enter);
Mouse.Middle:up =>;
