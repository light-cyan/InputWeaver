TARGET = "notepad.exe";
TAP_DURATION = 25ms;
ACTION_GAP = 10ms;

number spinCount = 0;

// Full mapping ownership used for foreground-loss and startup-state acceptance.
F6 := A;

// A timed task used to prove stale generations cannot resume after foreground loss.
F7:down => tap(B) wait(250ms) tap(C);

// A cooperative loop without positive-duration suspension must be budget-cancelled.
F8:down =>
    while F8[held] do
        set(spinCount, spinCount + 1)
    end;
F8:repeat =>;
F8:up =>;

// Process launch requires explicit command-line authority.
F9:down => exec("notepad.exe");
