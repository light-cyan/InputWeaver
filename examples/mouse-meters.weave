// Mouse meters and pointer actions in Visual Studio Code.
// Open Debug STATE to inspect Mouse, meters, counters, and captured arrays.
// Keep Code foreground and the pointer inside its editor when testing outputs.
// CapsLock+1 save position; CapsLock+2 restore; CapsLock+3 small square; CapsLock+4 fractional scrolling.
// CapsLock+5 change distance period; CapsLock+6 restart meters; CapsLock+7 capture current fields.
// CapsLock+8 capture a completed cycle across a wait; CapsLock+9 toggle movement-to-scroll.
// CapsLock+0 change time period; Pause suspend/resume; CapsLock+Esc exit.
// Hold left Shift to count raw mouse reports. Gestures start disabled.
// CapsLock is a held command prefix while this example is active in Code.

TARGET = "Code.exe";
MOUSE_IDLE_TIMEOUT = 80ms;
ACTION_GAP = 10ms;

number stride = 24;
duration interval = 100ms;
meter path = Mouse:move every stride;
meter fine = Mouse:move every 8;
meter pulse = Mouse:move every interval;
meter vertical = Mouse:wheel every 1;
meter horizontal = Mouse:horizontalwheel every 0.25;

state gestures = off;
state saved = off;
state sampledMoving = off;
state snapshotReady = off;
number savedX = 0;
number savedY = 0;
number rawMoves = 0;
number rawVertical = 0;
number rawHorizontal = 0;
number pathCycles = 0;
number fineCycles = 0;
number pulseCycles = 0;
number lastVertical = 0;
number lastHorizontal = 0;
number sampledPeriod = 0;
number sampledRemaining = 0;
duration sampledIdle = 0ms;
duration sampledTimeProgress = 0ms;
duration sampledTimeRemaining = 0ms;

// live: x, y, dx, dy, wheel_x, wheel_y.
number[] live = [0, 0, 0, 0, 0, 0];
// current: start_x, start_y, x, y, dx, dy, distance, progress.
number[] current = [0, 0, 0, 0, 0, 0, 0, 0];
// before/after: start_x, start_y, x, y, dx, dy, distance, period.
number[] before = [0, 0, 0, 0, 0, 0, 0, 0];
number[] after = [0, 0, 0, 0, 0, 0, 0, 0];

// Raw events work independently of meter declarations and forward native input.
Mouse:move when LShift == held ~> set(rawMoves, rawMoves + 1);
Mouse:wheel when LShift == held ~> set(rawVertical, rawVertical + 1);
Mouse:horizontalwheel when LShift == held ~> set(rawHorizontal, rawHorizontal + 1);

// Two subscriptions share path's phase; fine has its own distance boundaries.
path:tick ~>> set(pathCycles, pathCycles + 1);
path:tick when gestures == on ~>
    if @path.dx * @path.dx >= @path.dy * @path.dy then
        if @path.dx > 0 then scroll_horizontal(0.25) end
        if @path.dx < 0 then scroll_horizontal(-0.25) end
    else
        if @path.dy > 0 then scroll(-0.25) end
        if @path.dy < 0 then scroll(0.25) end
    end;
fine:tick ~> set(fineCycles, fineCycles + 1);

// Continuous movement confirms time boundaries; an 80ms idle gap restarts pulse.
pulse:tick ~> set(pulseCycles, pulseCycles + 1);
// Completed wheel values retain their sign; reversing cancels the current remainder.
vertical:tick ~> set(lastVertical, @vertical.wheel_y);
horizontal:tick ~> set(lastHorizontal, @horizontal.wheel_x);

// Consume the prefix so example commands leave the CapsLock toggle unchanged.
CapsLock:down =>;
CapsLock:up =>;

Digit1:down when CapsLock == held => set(savedX, Mouse.x) set(savedY, Mouse.y) set(saved, on);
Digit2:down when CapsLock == held and saved == on => move_to(savedX, savedY);
Digit2:down when CapsLock == held =>;

// Fractional relative pixels accumulate: 24 half-pixel steps move 12 pixels.
Digit3:down when CapsLock == held =>
    repeat 24 do move_by(0.5, 0) wait(10ms) end
    move_by(0, 12) wait(120ms)
    move_by(-12, 0) wait(120ms)
    move_by(0, -12);
Digit4:down when CapsLock == held => scroll(0.25) wait(200ms) scroll_horizontal(0.25);

// Changes take effect when the next cycle opens, preserving the current phase.
Digit5:down when CapsLock == held =>
    if stride == 24 then set(stride, 48) else set(stride, 24) end;
Digit0:down when CapsLock == held =>
    if interval == 100ms then set(interval, 250ms) else set(interval, 100ms) end;

// Reset meter state explicitly; the user counters retain their totals.
Digit6:down when CapsLock == held => restart(path) restart(fine) restart(pulse) restart(vertical) restart(horizontal);
Digit9:down when CapsLock == held => toggle(gestures) restart(path);

// Current fields are read when these actions execute, not when a cycle completes.
Digit7:down when CapsLock == held =>
    set(live[0], Mouse.x) set(live[1], Mouse.y)
    set(live[2], Mouse.dx) set(live[3], Mouse.dy)
    set(live[4], Mouse.wheel_x) set(live[5], Mouse.wheel_y)
    set(sampledMoving, Mouse.moving) set(sampledIdle, Mouse.idle_time)
    set(current[0], path.start_x) set(current[1], path.start_y)
    set(current[2], path.x) set(current[3], path.y)
    set(current[4], path.dx) set(current[5], path.dy)
    set(current[6], path.distance) set(current[7], path.progress)
    set(sampledPeriod, path.period) set(sampledRemaining, path.remaining)
    set(sampledTimeProgress, pulse.progress) set(sampledTimeRemaining, pulse.remaining);

// A key-triggered task selects the latest completion. Keep moving during the wait:
// path and @path in STATE advance, but this task's before/after arrays stay equal.
// Restarting meters with CapsLock+6 during the wait also preserves this task's selection.
Digit8:down when CapsLock == held and @path.valid == on =>
    set(snapshotReady, off)
    set(before[0], @path.start_x) set(before[1], @path.start_y)
    set(before[2], @path.x) set(before[3], @path.y)
    set(before[4], @path.dx) set(before[5], @path.dy)
    set(before[6], @path.distance) set(before[7], @path.period)
    wait(400ms)
    set(after[0], @path.start_x) set(after[1], @path.start_y)
    set(after[2], @path.x) set(after[3], @path.y)
    set(after[4], @path.dx) set(after[5], @path.dy)
    set(after[6], @path.distance) set(after[7], @path.period)
    set(snapshotReady, on);
Digit8:down when CapsLock == held =>;

pause Pause:down => toggle;
exit Esc:down when CapsLock == held;
